{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "free-pos-auth",
	"main": "src/index.ts",
	"minify": true,
	"compatibility_date": "2026-08-02",
	"compatibility_flags": ["nodejs_compat_v2"],
	"observability": {
		"enabled": true
	},
	// All four bindings (FREE_POS_DATABASE_URL, FREE_POS_JWT_SECRET, FREE_POS_FRONTEND_ORIGIN,
	// FREE_POS_COOKIE_DOMAIN) are real secrets configured out-of-band via `wrangler secret put`
	// and never appear in this file. `.dev.vars` supplies all four for local dev — see
	// .dev.vars.example.
	"dev": {
		"port": 8787
	}
}
