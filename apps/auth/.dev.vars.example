FREE_POS_DATABASE_URL=mysql://user:password@host:4000/database
# Must be identical in every Worker that verifies auth tokens, including apps/shop.
FREE_POS_JWT_SECRET=change-me
FREE_POS_FRONTEND_ORIGIN=http://localhost:5173
# Left unset on purpose: an empty override makes the access-token cookie
# host-only in local dev, overriding the prod secret value (.yourdomain.com).
FREE_POS_COOKIE_DOMAIN=
# Resend delivery. Empty/absent -> the forgot-password flow falls back to
# console.logging the would-be email (wrangler dev prints the clickable link).
FREE_POS_EMAIL_API_KEY=
# Resend "from" address. Sending domain must be verified in the Resend dashboard.
FREE_POS_EMAIL_FROM=Free POS <no-reply@yourdomain.com>
# Google OAuth. Keep the client secret server-side; do not expose it to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/login/google/callback
