SERO_POS_DATABASE_URL=mysql://user:password@host:4000/database
SERO_POS_JWT_SECRET=change-me
SERO_POS_FRONTEND_ORIGIN=http://localhost:3000
# Left unset on purpose: an empty override makes the access-token cookie
# host-only in local dev, overriding wrangler.jsonc's prod value (.sero-pos.com).
SERO_POS_COOKIE_DOMAIN=
