{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "free-pos-frontend",
	"compatibility_date": "2026-08-04",
	// No `main` — this is a static-assets-only Worker, no server code.
	// Custom domain (app.yourdomain.com) is attached manually via the Cloudflare
	// dashboard, same as free-pos-auth's auth.yourdomain.com — not configured here.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
