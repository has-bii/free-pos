{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^typecheck"]
		},
		"lint": {
			"dependsOn": ["^typecheck"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^typecheck"],
			// Turbo runs tasks in strict env mode, so an undeclared var never
			// reaches vitest. Without this, CI would silently fall through to an
			// empty SERO_POS_DATABASE_URL binding and trip test/setup.ts's guard.
			// It is also a cache key: pointing at a different database re-runs.
			"env": ["TEST_DATABASE_URL"]
		}
	}
}
