{
	"name": "free-pos",
	"private": true,
	"packageManager": "pnpm@11.16.0",
	"engines": {
		"node": "24.18.0"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "biome format --write .",
		"ui:add": "pnpm dlx shadcn@latest add --cwd packages/ui",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"lefthook": "2.1.10",
		"turbo": "2.10.8",
		"typescript": "catalog:"
	},
	"dependencies": {
		"dotenv": "catalog:"
	}
}
