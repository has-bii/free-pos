# TiDB connection string used by drizzle-kit (db:generate / db:migrate)
# and passed to createDatabaseClient() at runtime.
#
# TiDB Cloud Serverless format (ssl param is required, plain-text connections are rejected):
# mysql://<user>.root:<password>@<host>/<database>?ssl={"minVersion":"TLSv1.2"}
DATABASE_URL=
